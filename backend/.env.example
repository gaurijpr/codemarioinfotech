# ===================================================
# CODEMARIO INFOTECH - BACKEND ENVIRONMENT VARIABLES
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Target inquiry receiver email
CONTACT_EMAIL=hello@codemarioinfotech.com

# SMTP Server Configuration (Required for live email delivery)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
#
# Example for Hostinger / cPanel:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@codemarioinfotech.com
# SMTP_PASSWORD=your-email-account-password
#
# Example for Resend / SendGrid / Mailgun:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Codemario Infotech <hello@codemarioinfotech.com>"
